<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mVm="clr-namespace:Optepafi.ViewModels.Main"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Optepafi.Views.Main.Windows.SimpleMessageWindow"
        x:DataType="mVm:SimpleMessageWindowViewModel"
        Width="300" Height="150"
        WindowStartupLocation="CenterScreen">
    <StackPanel>
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0 0 0 20"/>
        <Button Content="OK" Width="80" HorizontalAlignment="Center" Click="Button_OnClick"/>
    </StackPanel>
</Window>
